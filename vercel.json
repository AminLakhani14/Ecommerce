{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.sbrfashion.com" }], "destination": "https://sbrfashion.com/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/:section(login|register|cart|shipping|profile|thankyou|order)/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
  ],
  "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }]
}
